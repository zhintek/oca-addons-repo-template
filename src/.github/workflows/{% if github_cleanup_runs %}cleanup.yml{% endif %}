name: Cleanup orphaned artifacts

on:
  schedule:
    - cron: '0 3 * * 0'  # todos los domingos a las 3 AM UTC
  workflow_dispatch:

jobs:
  cleanup:
    runs-on: ubuntu-latest
    permissions:
      actions: write
      contents: read
    steps:
      - name: Delete orphaned artifacts (branches no longer exist)
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const owner = context.repo.owner;
            const repo = context.repo.repo;

            const artifacts = await github.paginate(
              github.rest.actions.listArtifactsForRepo,
              { owner, repo, per_page: 100 }
            );

            const branchExists = new Map();
            const deleted = [];
            const failed = [];
            let kept = 0;
            let skipped = 0;

            for (const artifact of artifacts) {
              const branch = artifact.workflow_run?.head_branch;
              if (artifact.expired || !branch) {
                skipped++;
                continue;
              }

              try {
                if (!branchExists.has(branch)) {
                  try {
                    await github.rest.repos.getBranch({ owner, repo, branch });
                    branchExists.set(branch, true);
                  } catch (branchError) {
                    if (branchError.status !== 404) throw branchError;
                    branchExists.set(branch, false);
                  }
                }

                if (branchExists.get(branch)) {
                  kept++;
                  console.log(`Branch '${branch}' still exists — keeping artifact '${artifact.name}'`);
                  continue;
                }

                await github.rest.actions.deleteArtifact({
                  owner,
                  repo,
                  artifact_id: artifact.id
                });
                deleted.push(artifact);
                console.log(`🗑 Deleted artifact '${artifact.name}' from deleted branch '${branch}'`);
              } catch (e) {
                failed.push({ artifact, message: e.message });
                console.log(`⚠️ Failed to process artifact '${artifact.name}' (branch '${branch}'): ${e.message}`);
              }
            }

            const toMB = (bytes) => (bytes / 1024 / 1024).toFixed(2);
            const freed = deleted.reduce((total, a) => total + a.size_in_bytes, 0);

            core.summary
              .addHeading('Orphaned artifacts cleanup')
              .addTable([
                [{ data: 'Checked', header: true }, { data: 'Kept', header: true },
                 { data: 'Deleted', header: true }, { data: 'Skipped', header: true },
                 { data: 'Failed', header: true }, { data: 'Freed (MB)', header: true }],
                [`${artifacts.length}`, `${kept}`, `${deleted.length}`,
                 `${skipped}`, `${failed.length}`, toMB(freed)],
              ]);

            if (deleted.length) {
              core.summary.addHeading('Deleted artifacts', 3).addTable([
                [{ data: 'Artifact', header: true }, { data: 'Branch', header: true },
                 { data: 'Size (MB)', header: true }, { data: 'Created', header: true }],
                ...deleted.map((a) => [
                  a.name, a.workflow_run.head_branch, toMB(a.size_in_bytes), a.created_at,
                ]),
              ]);
            }

            if (failed.length) {
              core.summary.addHeading('Failures', 3).addTable([
                [{ data: 'Artifact', header: true }, { data: 'Branch', header: true },
                 { data: 'Error', header: true }],
                ...failed.map(({ artifact, message }) => [
                  artifact.name, artifact.workflow_run?.head_branch ?? '', message,
                ]),
              ]);
            }

            await core.summary.write();

            if (failed.length) {
              core.setFailed(`${failed.length} artifact(s) could not be processed`);
            }
